<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="324.0" prefWidth="424.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.calcufx.controller.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Label layoutX="145.0" layoutY="17.0" text="Calculadora" textAlignment="CENTER" textFill="#00866b" textOverrun="WORD_ELLIPSIS">
      <font>
         <Font name="System Bold Italic" size="21.0" />
      </font>
      <opaqueInsets>
         <Insets />
      </opaqueInsets>
   </Label>


    <Label fx:id="welcomeText" />
   <RadioButton fx:id="suma" layoutX="14.0" layoutY="183.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="80.0" selected="true" text="suma" textAlignment="RIGHT">
      <toggleGroup>
         <ToggleGroup fx:id="grupoOperacion" />
      </toggleGroup></RadioButton>
   <RadioButton fx:id="resta" layoutX="106.0" layoutY="187.0" mnemonicParsing="false" text="resta" toggleGroup="$grupoOperacion" />
   <RadioButton fx:id="mult" layoutX="182.0" layoutY="187.0" mnemonicParsing="false" text="multiplicacion" toggleGroup="$grupoOperacion" />
   <RadioButton fx:id="div" layoutX="298.0" layoutY="187.0" mnemonicParsing="false" text="division" toggleGroup="$grupoOperacion" />
   <Label layoutX="17.0" layoutY="149.0" text="Operacion">
      <font>
         <Font size="16.0" />
      </font>
   </Label>
   <Label layoutX="49.0" layoutY="75.0" text="A:" />
   <Label layoutX="49.0" layoutY="115.0" text="B:" />
   <TextField fx:id="numA" layoutX="79.0" layoutY="71.0" promptText="primer numero" />
   <TextField fx:id="numB" layoutX="79.0" layoutY="111.0" promptText="segundo numero" />
   <TextField fx:id="respuesta" layoutX="94.0" layoutY="233.0" />
   <Label layoutX="31.0" layoutY="237.0" text="Respuesta:" />
   <Button fx:id="btCal" layoutX="331.0" layoutY="233.0" mnemonicParsing="false" onAction="#calcular" text="Calcular" />
   <Button fx:id="limpiar" layoutX="272.0" layoutY="233.0" mnemonicParsing="false" text="Limpiar" />

</AnchorPane>
